{
  "opening": "create",
  "authority": "system::sibardoc",
  "sets": ["assignees"],
  "records": { "value": "metadata_set", "join": "assigned", "leave": "unassigned", "warning": "goal_warning" },
  "judged": ["user"],
  "gists": [
    {
      "gist": "create",
      "writers": ["user"],
      "rules": [
        { "rule": "value", "key": "name", "from": "name", "required": true },
        { "rule": "value", "key": "status", "value": "open" },
        { "rule": "join", "set": "assignees", "from": "assignTo", "required": true }
      ]
    },
    {
      "gist": "memo",
      "writers": ["user", "goal"],
      "rules": [{ "rule": "join", "set": "assignees", "from": "assignTo" }],
      "when": { "values": { "status": "open" }, "in": "assignees" }
    },
    {
      "gist": "memo_revoke",
      "writers": ["user"],
      "rules": [{ "rule": "revoke", "from": "target", "gists": ["memo"] }],
      "when": { "values": { "status": "open" }, "in": "assignees" }
    },
    { "gist": "comment", "writers": ["user"], "rules": [], "when": { "in": "assignees" } },
    {
      "gist": "got_it",
      "writers": ["user"],
      "rules": [{ "rule": "value", "key": "acknowledged", "from": "about", "required": true }],
      "when": { "values": { "status": "open" }, "in": "assignees", "checks": [{ "gist": "memo" }] }
    },
    {
      "gist": "doc_ref",
      "writers": ["user"],
      "rules": [
        { "rule": "value", "key": "documents", "collect": "document", "required": true },
        { "rule": "value", "key": "documents_in", "collect": "document", "where": { "direction": "inbound" } },
        { "rule": "value", "key": "documents_out", "collect": "document", "where": { "direction": "outbound" } }
      ],
      "when": { "values": { "status": "open" }, "in": "assignees" }
    },
    {
      "gist": "doc_ref_revoke",
      "writers": ["user"],
      "rules": [{ "rule": "revoke", "from": "target", "gists": ["doc_ref"] }],
      "when": { "values": { "status": "open" }, "in": "assignees" }
    },
    {
      "gist": "set_goal",
      "writers": ["user"],
      "rules": [{ "rule": "goal" }],
      "when": { "values": { "status": "open" }, "in": "assignees" }
    },
    {
      "gist": "set_goal_revoke",
      "writers": ["user"],
      "rules": [{ "rule": "revoke", "from": "target", "gists": ["set_goal"] }],
      "when": { "in": "assignees" }
    },
    {
      "gist": "stage",
      "writers": ["user", "goal"],
      "rules": [{ "rule": "value", "key": "stage", "from": "stage", "required": true }],
      "when": { "values": { "status": "open" }, "in": "assignees" }
    },
    {
      "gist": "closed",
      "writers": ["goal", "user"],
      "rules": [{ "rule": "value", "key": "status", "value": "closed" }],
      "when": { "values": { "status": "open" }, "in": "assignees" }
    },
    {
      "gist": "closed_revoke",
      "writers": ["user"],
      "rules": [{ "rule": "revoke", "from": "target", "gists": ["closed"] }],
      "when": { "in": "assignees" }
    },
    { "gist": "quit", "writers": ["user"], "rules": [{ "rule": "leave", "set": "assignees" }], "when": { "in": "assignees" } },
    { "gist": "doc_signed", "writers": ["system"], "rules": [] },
    { "gist": "doc_created", "writers": ["system"], "rules": [] },
    { "gist": "assigned", "writers": ["system"], "rules": [] },
    { "gist": "unassigned", "writers": ["system"], "rules": [] },
    { "gist": "metadata_set", "writers": ["system"], "rules": [] },
    { "gist": "goal_warning", "writers": ["goal"], "rules": [] }
  ],
  "laws": [
    { "law": "keeps-set", "set": "assignees", "while": { "status": "open" }, "strength": "refuse" },
    { "law": "keeps-goals", "strength": "confirm" },
    { "law": "settles", "strength": "refuse" }
  ]
}
