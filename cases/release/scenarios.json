[
  {
    "id": "two-releases",
    "title": "Two releases of one package on one thread: each tag is made, built, approved and published, and the publication is expected from the approval until it is posted",
    "steps": [
      {"label": "open", "writer": "user::mrossi", "gist": "opened", "payload": {"package": "consequitur", "approvers": ["mrossi", "lbianchi"]}},
      {"label": "tag-r1", "writer": "system::git", "gist": "tagged", "payload": {"tag": "R1.0"}},
      {"label": "build-r1", "writer": "system::mac", "gist": "built", "payload": {"tag": "R1.0", "outputs": {"consequitur-1.0.0.tgz": "sha256:4f1c0a"}}},
      {"label": "approve-r1", "writer": "user::lbianchi", "gist": "approved", "payload": {"tag": "R1.0"}},
      {"label": "publish-r1", "writer": "system::tabularium", "gist": "published", "payload": {"tag": "R1.0"}},
      {"label": "tag-r2", "writer": "system::git", "gist": "tagged", "payload": {"tag": "R2.0"}},
      {"label": "build-r2", "writer": "system::gitlab", "gist": "built", "payload": {"tag": "R2.0", "outputs": {"consequitur-2.0.0.tgz": "sha256:9b7e21"}}},
      {"label": "approve-r2", "writer": "user::mrossi", "gist": "approved", "payload": {"tag": "R2.0"}},
      {"label": "publish-r2", "writer": "system::tabularium", "gist": "published", "payload": {"tag": "R2.0"}}
    ]
  },
  {
    "id": "failed-and-retried",
    "title": "A publication fails: the failure is a line, the publication is still expected, and the retry that succeeds answers it",
    "steps": [
      {"label": "open", "writer": "user::mrossi", "gist": "opened", "payload": {"package": "consequitur", "approvers": ["mrossi", "lbianchi"]}},
      {"label": "tag-r1", "writer": "system::git", "gist": "tagged", "payload": {"tag": "R1.0"}},
      {"label": "build-r1", "writer": "system::mac", "gist": "built", "payload": {"tag": "R1.0", "outputs": {"consequitur-1.0.0.tgz": "sha256:4f1c0a"}}},
      {"label": "approve-r1", "writer": "user::lbianchi", "gist": "approved", "payload": {"tag": "R1.0"}},
      {"label": "failed-r1", "writer": "system::tabularium", "gist": "publish_failed", "payload": {"tag": "R1.0", "why": "the registry did not answer"}},
      {"label": "publish-r1", "writer": "system::tabularium", "gist": "published", "payload": {"tag": "R1.0"}}
    ]
