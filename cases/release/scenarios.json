  {
    "id": "refused",
    "title": "The five refusals: a tag approved before it is built, a publication of a tag not approved, an approval by someone not an approver, a publication by a writer other than tabularium, and a retraction of a tag not published",
    "steps": [
      {"label": "open", "writer": "user::mrossi", "gist": "opened", "payload": {"package": "consequitur", "approvers": ["mrossi", "lbianchi"]}},
