{
  "opening": "submit",
  "authority": "system::clock",
  "sets": ["team", "reviewers", "editors"],
  "records": { "value": "value_set", "join": "joined", "leave": "left", "warning": "goal_warning" },
  "judged": ["user"],
  "guards": {
    "member": { "is": { "$writer": "id" }, "values": [{ "$set": "team" }] },
    "reviewer": { "is": { "$writer": "id" }, "values": [{ "$set": "reviewers" }] },
    "editor": { "is": { "$writer": "id" }, "values": [{ "$set": "editors" }] },
    "reviewing": { "all": [{ "guard": "reviewer" }, { "is": { "$value": "status" }, "values": ["in_review"] }] }
  },
  "gists": [
    {
      "gist": "submit",
      "writers": ["user"],
      "rules": [
        { "rule": "value", "key": "title", "from": "title", "required": true },
        { "rule": "value", "key": "status", "value": "draft" },
        { "rule": "value", "key": "version", "from": "version", "required": true },
        { "rule": "join", "set": "team", "from": "authors", "required": true },
        { "rule": "join", "set": "editors", "from": "editor", "required": true }
      ]
    },
    {
      "gist": "revision",
      "writers": ["user"],
      "rules": [
        { "rule": "value", "key": "version", "from": "version", "required": true },
        { "rule": "value", "key": "status", "value": "in_review" }
      ],
      "when": { "all": [{ "guard": "member" }, { "is": { "$value": "status" }, "values": ["changes_requested"] }] }
    },
    {
      "gist": "request_review",
      "writers": ["user"],
      "rules": [
        { "rule": "join", "set": "reviewers", "from": "reviewers", "required": true },
        { "rule": "join", "set": "team", "from": "reviewers", "required": true },
        { "rule": "value", "key": "status", "value": "in_review" }
      ],
      "when": { "guard": "member" }
    },
    {
      "gist": "approve",
      "writers": ["user"],
      "rules": [{ "rule": "value", "key": "approvals", "collect": "stamp", "required": true }],
      "when": { "guard": "reviewing" }
    },
    {
      "gist": "approve_revoke",
      "writers": ["user"],
      "rules": [{ "rule": "revoke", "from": "target", "gists": ["approve"] }],
      "when": { "guard": "reviewing" }
    },
    {
      "gist": "request_changes",
      "writers": ["user"],
      "rules": [{ "rule": "value", "key": "status", "value": "changes_requested" }],
      "when": { "guard": "reviewing" }
    },
    { "gist": "comment", "writers": ["user"], "rules": [], "when": { "guard": "member" } },
    { "gist": "set_goal", "writers": ["user"], "rules": [{ "rule": "goal" }], "when": { "guard": "editor" } },
    {
      "gist": "set_goal_revoke",
      "writers": ["user"],
      "rules": [{ "rule": "revoke", "from": "target", "gists": ["set_goal"] }],
      "when": { "guard": "editor" }
    },
    {
      "gist": "publish",
      "writers": ["goal", "user"],
      "rules": [{ "rule": "value", "key": "status", "value": "published" }],
      "when": { "all": [{ "guard": "editor" }, { "is": { "$value": "status" }, "values": ["in_review"] }] }
    },
    {
      "gist": "deadline",
      "writers": ["user"],
      "rules": [{ "rule": "value", "key": "deadline", "from": "date", "required": true }],
      "when": { "guard": "editor" }
    },
    { "gist": "deadline_passed", "writers": ["system"], "rules": [{ "rule": "value", "key": "late", "value": true }] },
    {
      "gist": "leave_team",
      "writers": ["user"],
      "rules": [
        { "rule": "leave", "set": "team" },
        { "rule": "leave", "set": "reviewers" }
      ],
      "when": { "guard": "member" }
    },
    { "gist": "value_set", "writers": ["system"], "rules": [] },
    { "gist": "joined", "writers": ["system"], "rules": [] },
    { "gist": "left", "writers": ["system"], "rules": [] },
    { "gist": "goal_warning", "writers": ["goal"], "rules": [] }
  ],
  "laws": [
    { "law": "keeps-set", "set": "reviewers", "while": { "status": "in_review" }, "strength": "refuse" },
    { "law": "keeps-set", "set": "editors", "strength": "refuse" },
    { "law": "keeps-goals", "strength": "confirm" },
    { "law": "settles", "strength": "refuse" }
  ]
}
