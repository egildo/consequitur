{
  "name": "consequitur-kdl",
  "version": "0.3.1",
  "type": "module",
  "license": "MIT",
  "description": "A consequitur schema written in KDL, read into the schema object and written back.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@bgotink/kdl": "^0.4.0",
    "consequitur": "workspace:^",
    "kdlet-guards": "^0.3.0"
  },
  "keywords": [
    "consequitur",
    "kdl",
    "schema"
  ],
  "author": "Egildo Tagliareni <egildo@tagliareni.it>",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/egildo/consequitur.git",
    "directory": "packages/consequitur-kdl"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "homepage": "https://codeberg.org/egildo/consequitur",
  "bugs": {
    "url": "https://codeberg.org/egildo/consequitur/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
