{
  "name": "consequitur",
  "version": "0.1.0",
  "description": "A ledger of what was said, and what follows from it.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "kdlet-guards": "^0.2.1"
  },
  "keywords": [
    "ledger",
    "event-sourcing",
    "hash-chain",
    "thread",
    "rules",
    "schema",
    "reconciliation"
  ],
  "author": "Egildo Tagliareni <egildo@tagliareni.it>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/egildo/consequitur.git",
    "directory": "packages/consequitur"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "homepage": "https://codeberg.org/egildo/consequitur",
  "bugs": {
    "url": "https://codeberg.org/egildo/consequitur/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
